# --- База данных (выберите одну строку) ---
DATABASE_URL=sqlite:./data/app.db
# DATABASE_URL=postgres://user:password@host:5432/dbname     # npm i pg
# DATABASE_URL=mysql://user:password@host:3306/dbname        # npm i mysql2

# --- Telegram ---
# Токен бота от @BotFather: через него проходит вход в Mini App, он же шлёт уведомления
BOT_TOKEN=
# Публичный HTTPS-адрес приложения (для кнопки «Открыть» в боте)
WEB_APP_URL=

# --- Прочее ---
PORT=3000
TZ_NAME=Europe/Minsk
CURRENCY=₽
# Ограничить доступ: Telegram ID или @username через запятую (пусто = все)
ALLOWED_USERS=
# Только для локальной проверки в браузере (отключает проверку Telegram!)
# DEV_AUTH=1
